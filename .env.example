# Database (SQL Server). Other app settings use the SR_ prefix.
DB_USER=sa
DB_PASSWORD=<your-sa-password>
DB_SERVER=localhost
DB_DATABASE=shiftreporting
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
SR_PORT=3000
SR_APP_BASE_URL=http://localhost:5173
SR_APP_TIMEZONE=Africa/Nairobi
SR_COOKIE_SECURE=false
SR_SESSION_HOURS=12
SR_SEED_ADMIN_EMAIL=admin@shiftreporting.local
SR_SEED_ADMIN_NAME=System Administrator
SR_SEED_ADMIN_PASSWORD=ChangeMe2026!
# Set true only when running behind a reverse proxy that sets X-Forwarded-For
SR_TRUST_PROXY=false
