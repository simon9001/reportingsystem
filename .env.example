# Database (SQL Server). Other app settings use the SR_ prefix.
DB_USER=sa
DB_PASSWORD=<your-sa-password>
DB_SERVER=localhost
DB_DATABASE=shiftreporting
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
SR_PORT=3000
SR_APP_BASE_URL=http://localhost:5173
SR_APP_TIMEZONE=Africa/Nairobi
SR_COOKIE_SECURE=false
SR_SESSION_HOURS=12
SR_SEED_ADMIN_EMAIL=admin@shiftreporting.local
SR_SEED_ADMIN_NAME=System Administrator
SR_SEED_ADMIN_PASSWORD=ChangeMe2026!
# Set true only when running behind a reverse proxy that sets X-Forwarded-For
SR_TRUST_PROXY=false
SR_UPLOAD_DIR=uploads

# Email (optional). Without SR_SMTP_HOST, emails are logged as "Skipped — SMTP not configured".
# Microsoft 365: smtp.office365.com, port 587, secure false. Gmail: smtp.gmail.com, 587, false, app password.
SR_SMTP_HOST=
SR_SMTP_PORT=587
SR_SMTP_SECURE=false
SR_SMTP_USER=
SR_SMTP_PASSWORD=
SR_SMTP_FROM="KeNHA Control Room <controlroom@example.org>"
# Where submitted report PDFs are stored (persistent disk in production)
SR_REPORT_DIR=reports
