{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:test:deploy": "cross-env SR_ENV_FILE=.env.test prisma migrate deploy",
    "e2e:prepare": "cross-env SR_ENV_FILE=.env.test tsx scripts/e2e-prepare.ts",
    "e2e:server": "cross-env SR_ENV_FILE=.env.test tsx src/index.ts",
    "pretest": "prisma generate && pnpm db:test:deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^2.1.3",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-mssql": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sr/shared": "workspace:*",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "cross-env": "^10.1.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
